<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhisperKeyboard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/keyboard_background</item>
        <item name="android:windowBackground">@color/keyboard_background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WhisperKeyboard.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.WhisperKeyboard.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.WhisperKeyboard.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WhisperKeyboard.Dialog</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.WhisperKeyboard.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.WhisperKeyboard.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.WhisperKeyboard.Body</item>
    </style>

    <style name="MaterialAlertDialog.WhisperKeyboard.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MaterialAlertDialog.WhisperKeyboard.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="ShapeAppearance.WhisperKeyboard.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
