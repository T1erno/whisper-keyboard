<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard_container"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <!-- Top Card Container for Voice Dictation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_container"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/status_idle"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Listening..." />

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent_purple"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button_idle"
                android:contentDescription="Microphone"
                android:elevation="4dp"
                android:scaleType="center"
                android:src="@drawable/ic_mic"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Hold or tap to talk"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Cancel Transcription Button (Standard TextView to prevent MaterialComponents theme inflation crashes in IME) -->
        <TextView
            android:id="@+id/btn_cancel_transcription"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_blue_action_button"
            android:backgroundTint="#DC2626"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="✕ Cancel"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Punctuation Keys (5 clean keys without text labels underneath) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Key 1: Comma (Long press: Semicolon ;) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/key_comma"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_punct_key"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text=","
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- Key 2: Period (Long press: Colon :) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/key_period"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_punct_key"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="."
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- Key 3: Question (Long press: Inverted Question ¿) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/key_question"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_punct_key"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Key 4: Exclamation (Long press: Inverted Exclamation ¡) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/key_exclamation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_punct_key"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Key 5: Quotes (Long press: Single Quote ') -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:paddingStart="2dp">

            <TextView
                android:id="@+id/key_quotes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_punct_key"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text='"'
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Utility Action Bar & Spacebar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Settings / Gear Button (Bright White Tint) -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings"
            app:tint="#FFFFFF" />

        <!-- Hide Keyboard Button (Bright White Tint) -->
        <ImageButton
            android:id="@+id/btn_hide_keyboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Hide Keyboard"
            android:src="@drawable/ic_keyboard_hide"
            app:tint="#FFFFFF" />

        <!-- Center Spacebar Key -->
        <TextView
            android:id="@+id/btn_space"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_punct_key"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Space"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Backspace (Hold for accelerated continuous deletion) -->
        <ImageButton
            android:id="@+id/btn_backspace"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Backspace"
            android:src="@drawable/ic_backspace"
            app:tint="#FFFFFF" />

        <!-- Purple Action / Enter Button -->
        <ImageButton
            android:id="@+id/btn_enter"
            android:layout_width="52dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_blue_action_button"
            android:contentDescription="Enter"
            android:src="@drawable/ic_arrow_right"
            app:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
